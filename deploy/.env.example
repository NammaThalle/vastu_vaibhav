SECRET_KEY=generate-with-openssl-rand-hex-32
# Login stays valid for 30 days.
ACCESS_TOKEN_EXPIRE_MINUTES=43200
# Where the weekly backups go, for example an NFS mount of the Synology NAS.
BACKUP_DIR=./backups
# The release to run, without the v: the git tag v1.0.0 is VASTU_TAG=1.0.0.
VASTU_TAG=1.0.0
# Supplier portal login for the daily order sync. Leave empty to only paste orders.
# Use a password that is not used anywhere else.
SUPPLIER_LOGIN=
SUPPLIER_PASSWORD=
